{
  "name": "dickalo",
  "version": "1.0.0",
  "private": true,
  "description": "DICKALO — architecture and construction studio, Lagos, Nigeria.",
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild@0.25.6": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:construction": "node --experimental-strip-types --test tests/construction*.test.mjs",
    "test:virtual-tour": "node --test tests/virtual-tour.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@portabletext/react": "^3.1.0",
    "@sanity/image-url": "^1.0.2",
    "@sanity/vision": "^3.57.4",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.6",
    "gsap": "^3.12.5",
    "lenis": "^1.1.13",
    "next": "14.2.35",
    "next-sanity": "^9.5.0",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^4.0.1",
    "sanity": "^3.57.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^2.5.2",
    "three": "^0.186.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.15",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "postcss-import": "^17.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
