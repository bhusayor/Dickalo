# ---------------------------------------------------------------------------
# DICKALO — environment variables
# Copy to `.env.local` for development. Add the same keys to Vercel for prod.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser. Never put a secret
# behind that prefix.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# No trailing slash. Used for canonical URLs, OG tags, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://dickalo.com

# --- Sanity CMS -------------------------------------------------------------
# Project ID and dataset from sanity.io/manage. If you do not use Sanity yet,
# omit all four CMS variables from Vercel; the site uses its bundled content.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Must be exactly `1` or a date in YYYY-MM-DD format.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Read token with "Viewer" rights. Only needed for draft previews.
SANITY_API_READ_TOKEN=your_sanity_read_token

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server only. Bypasses row level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=re_your_api_key
# Must be a verified sending domain in Resend.
EMAIL_FROM="DICKALO <studio@dickalo.com>"
# Where new enquiries land.
EMAIL_TO=studio@dickalo.com

# --- Revalidation -----------------------------------------------------------
# Shared secret for the /api/revalidate webhook called by Sanity.
REVALIDATE_SECRET=generate_a_long_random_string

# --- Analytics (optional) ---------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
